{
  "manifest_version": 3,
  "name": "Music Remover (GTCRN Real-Time)",
  "version": "1.0.0",
  "description": "100% in-browser real-time background music & noise removal for any Chrome tab using ONNX Runtime Web.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Music Remover"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}